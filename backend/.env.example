# =============================================================================
# Button Factory MES - Environment Configuration Template
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Public Domain & DuckDNS Configuration
# -----------------------------------------------------------------------------
PUBLIC_DOMAIN=testtt234e.duckdns.org
DUCKDNS_DOMAIN=testtt234e.duckdns.org

# DuckDNS Token (from https://www.duckdns.org)
# When set, server automatically updates DuckDNS to current public IP on boot & hourly
DUCKDNS_TOKEN=

# -----------------------------------------------------------------------------
# 2. Free Tunnel Configuration (No router port-forwarding needed)
# -----------------------------------------------------------------------------
# Optional: 1 Free Permanent Static Domain from https://dashboard.ngrok.com/cloud-edge/domains
NGROK_DOMAIN=
NGROK_AUTHTOKEN=

# Optional: Cloudflare Named Tunnel Token from https://one.dash.cloudflare.com
CLOUDFLARE_TUNNEL_TOKEN=

# -----------------------------------------------------------------------------
# 3. Database Configuration (Multi-Tier)
# -----------------------------------------------------------------------------
# Active DB Tier ('sqlite' | 'postgres' | 'neon')
ACTIVE_DB_TIER=sqlite
SQLITE_DATABASE_URL=sqlite:///./btn_factory.db

# Tier 2: On-Premises Local PostgreSQL
LOCAL_POSTGRES_URL=postgresql://postgres:1234@localhost:5432/btn_factory

# Tier 3: Remote Cloud DR Backup (Neon Serverless PostgreSQL)
NEON_DATABASE_URL=

# -----------------------------------------------------------------------------
# 4. Storage & Automated Hourly Backup Folders
# -----------------------------------------------------------------------------
# Active folder where uploaded media/images are stored
MEDIA_DIR=./media

# Folder where automated hourly SQLite .db snapshots are saved
BACKUP_DIR=C:\Users\User\Downloads\backups

# Folder where automated hourly media files are backed up (defaults to <BACKUP_DIR>/media)
BACKUP_MEDIA_DIR=C:\Users\User\Downloads\backups\media

# Automated backup frequency in minutes while server runs (60 = 1 hour)
BACKUP_INTERVAL_MINUTES=60
