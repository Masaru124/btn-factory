# Button Factory MES - Environment Configuration Template

# DuckDNS & Custom Domain
PUBLIC_DOMAIN=testtt234e.duckdns.org
DUCKDNS_DOMAIN=testtt234e.duckdns.org

# Database Configuration
LOCAL_POSTGRES_URL=postgresql://postgres:1234@localhost:5432/btn_factory

# -----------------------------------------------------------------------------
# Storage & Automated Hourly Backup Folders
# (You can use relative paths like ./backups or absolute paths like D:/FactoryBackups)
# -----------------------------------------------------------------------------
# Active folder where uploaded media/images are stored
MEDIA_DIR=./media

# Folder where automated hourly SQLite .db snapshots are saved
BACKUP_DIR=./backups

# Folder where automated hourly media files are backed up (defaults to <BACKUP_DIR>/media)
BACKUP_MEDIA_DIR=./backups/media

# Automated backup frequency in minutes while server runs (60 = 1 hour)
BACKUP_INTERVAL_MINUTES=60
