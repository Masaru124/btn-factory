# 1. Primary Active Backend URL (FastAPI)
# Leave blank to automatically connect to current browser origin (port 80/8080/tunnel)
API_BASE_URL=https://aptly-nearly-footnote.ngrok-free.dev

# 2. Multiple Backend URLs (Allowed targets the frontend can call)
BACKEND_URLS=https://aptly-nearly-footnote.ngrok-free.dev,http://fasti2.duckdns.org,http://fasti2.duckdns.org:8080,http://fasti2.duckdns.org:8000,http://testtt234e.duckdns.org,http://127.0.0.1:8000,http://localhost:8000

# 3. Default DuckDNS Domain
DEFAULT_DUCKDNS_DOMAIN=fasti2.duckdns.org
